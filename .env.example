# ---------------------------------------------------------------------------
# Every variable here must also be declared in app/config.py.
# tests/test_config.py fails the build if the two drift apart.
# ---------------------------------------------------------------------------

# --- Core ---
# Railway injects PORT=8080, which overrides the Dockerfile's ENV PORT and leaves
# the generated domain pointing at the wrong port. Pin it as a service variable.
PORT=3000
APP_TARGET=web
RUN_MIGRATIONS=false
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-locally-and-never-in-deploy
LOG_LEVEL=INFO

# --- Database (Railway Postgres plugin provides this) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llmstxt

# --- Google SSO (internal team only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=prosperitymedia.com.au
# Skip auth entirely. Local convenience only -- refused on an https deployment.
ALLOW_ANONYMOUS=false

# --- LLM ---
# Blank the key rather than leaving a placeholder: a placeholder counts as
# "configured" and fails at call time instead of degrading to heuristics.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL_PLAN=gpt-4o
LLM_MODEL_TRIAGE=gpt-4o-mini
LLM_MODEL_SUMMARISE=gpt-4o-mini
LLM_MODEL_QA=gpt-4o
LLM_MODEL_CHAT=gpt-4o

# --- Crawler ---
# StealthyFetcher instantiates full Playwright: 800MB+ per concurrent session
# against ~40MB for plain HTTP. This cap is what keeps the worker inside 2GB.
MAX_BROWSER_CONCURRENCY=2
MAX_HTTP_CONCURRENCY=8
CRAWL_USER_AGENT=ProsperityLLMsTxtBot/1.0 (+https://prosperitymedia.com.au)
CRAWL_OBEY_ROBOTS=true
CRAWL_DEFAULT_MAX_PAGES=500

# --- Firecrawl (optional last rung of the fetch ladder) ---
# Only reached after HTTP, Dynamic and Stealth have all failed on a page, because
# it is the only tier that bills per page. Leave blank to keep the ladder free.
# No key exists in Prosperity yet -- provision one before relying on this.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

# --- Hosted Lighthouse ---
# PageSpeed Insights settles the two page checks a static parse cannot: layout
# shift (CLS) and tap-target size (WCAG 2.5.8). Hosted rather than a local
# Lighthouse, so the container needs no second browser.
#
# Free. Restrict the key to the PageSpeed Insights API -- it needs nothing else.
# Unkeyed calls are refused with a 429. With none set, both checks stay
# "needs a person" and the report says why rather than assuming a pass.
PAGESPEED_API_KEY=

# --- Interactive LLM ceiling ---
# A per-domain daily cap on interactive calls: the refine panel and the brief
# wizard. These run on LLM_MODEL_CHAT, which defaults to the most expensive
# model in the rate table, and are operator-driven rather than bounded by a job.
#
# Counted rather than priced, because a runaway loop is countable long before it
# is expensive. When the cap is hit the operator is told, rather than the turn
# quietly doing nothing.
MAX_INTERACTIVE_CALLS_PER_DAY=120

# --- Size pre-check ---
# One DataForSEO SERP call per site runs `site:domain` to get Google's indexed-page
# estimate, which is compared against the sitemap count before any crawl starts.
# Blank credentials simply skip it; the sitemap count still works.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SIZE_CHECK_LOCATION_CODE=2036
SIZE_CHECK_LANGUAGE_CODE=en

# Google Search Console: a path to a service-account key locally,
# or the whole JSON document in GSC_SERVICE_ACCOUNT_JSON on Railway.
# Never commit either.
GSC_SERVICE_ACCOUNT_FILE=
GSC_SERVICE_ACCOUNT_JSON=

# Query parameters that identify a distinct page, per site. Everything not
# listed here and matching a known tracking key is stripped when metrics are
# joined to sitemap URLs. Format: domain=param,param;domain=param
# e.g. carsguide.com.au=page,sort;example.com=ref
CANONICAL_MEANINGFUL_PARAMS=
